---
import ArticleListItem from "@/components/blog/ArticleListItem.astro";
import {
  getCategoryLabel,
  getCategoryPath,
  getCategoryDescription,
  type BlogCollection,
  type BlogEntry,
} from "@/lib/blog";
import { getCategoryPlaceholderImage } from "@/lib/blogImages";

interface Props {
  collection: BlogCollection;
  posts: BlogEntry[];
}

const { collection, posts } = Astro.props;
const label = getCategoryLabel(collection);
const path = getCategoryPath(collection);
const description = getCategoryDescription(collection);
const headingId = `blog-cat-${collection}`;
const categoryImage = getCategoryPlaceholderImage(collection);
---

<section class="blog-category-section" aria-labelledby={headingId}>
  <div class="blog-category-section-head">
    <img
      src={categoryImage}
      alt=""
      class="blog-category-section-thumb"
      width="120"
      height="68"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
    <div>
      <h2 id={headingId} class="blog-category-section-title">
        <a href={path}>{label}</a>
      </h2>
      <p class="blog-category-section-desc">{description}</p>
    </div>
    <a href={path} class="blog-category-section-more">Alle anzeigen</a>
  </div>

  {posts.length > 0 ? (
    <ol class="blog-index-list" role="list">
      {posts.map((post) => (
        <li>
          <ArticleListItem post={post} showCategory={false} />
        </li>
      ))}
    </ol>
  ) : (
    collection === "partners" ? (
      <a href="/blog/preview/partner-juli-2026" class="blog-partner-teaser">
        <img
          src="/images/blog/partner-spotlight-cover.svg"
          alt="Partner des Monats – Hebammen-Wissen für Eltern"
          class="blog-partner-teaser-cover"
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
        />
        <div class="blog-partner-teaser-body">
          <span class="blog-partner-teaser-label">Kommend</span>
          <p class="blog-partner-teaser-title">Partner des Monats: Hebammen-Wissen für den Alltag</p>
          <p class="blog-partner-teaser-text">Vorschau ansehen →</p>
        </div>
      </a>
    ) : (
      <p class="blog-category-section-empty">Noch keine Artikel in dieser Kategorie.</p>
    )
  )}
</section>

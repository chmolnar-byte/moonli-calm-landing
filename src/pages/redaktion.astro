---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Redaktion | Moonli" description="Weiterleitung zum Blog-Editor." noindex={true}>
  <div class="night-sky min-h-screen bg-gradient-page text-foreground flex items-center justify-center px-4">
    <div class="night-sky-stars fixed inset-0 z-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative z-10 glass-card-premium p-10 max-w-md w-full text-center">
      <h1 class="text-2xl font-bold mb-3">Moonli Redaktion</h1>
      <p class="text-muted-foreground mb-6">Du wirst zum Blog-Editor weitergeleitet…</p>
      <a
        href="/admin/index.html"
        class="inline-flex px-6 py-3 rounded-full bg-primary text-white font-semibold hover:opacity-90 transition-opacity"
      >
        Zum Editor →
      </a>
      <p class="text-xs text-muted-foreground mt-6">
        CMS-Server läuft? Starte mit <code class="text-foreground">npm run dev:all</code>
      </p>
    </div>
  </div>
  <script is:inline>
    window.location.replace("/admin/index.html");
  </script>
</BaseLayout>

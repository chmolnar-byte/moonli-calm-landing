---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingPage from "@/components/react/LandingPage";
import { SITE_ORIGIN, canonicalUrl } from "@/lib/seo";

const description =
  "Schlaf und Stillen ab der Geburt. Beikost, wenn der Löffel kommt. Wachfenster nach Alter, und beide Eltern sehen denselben Stand.";

const appStoreUrl =
  "https://apps.apple.com/us/app/moonli-baby-parent-assistant/id6762447948";
const playStoreUrl =
  "https://play.google.com/store/apps/details?id=com.christian.moonli&hl=de";

// Eindeutige Marken-Entität (Organization + WebSite), damit Suchmaschinen und
// KI-Systeme "Moonli" nicht mit ähnlich benannten Apps verwechseln.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_ORIGIN}/#organization`,
      name: "Moonli",
      url: `${SITE_ORIGIN}/`,
      logo: `${SITE_ORIGIN}/og-image.png`,
      founder: { "@type": "Person", name: "Christian Molnar" },
      sameAs: [appStoreUrl, playStoreUrl],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_ORIGIN}/#website`,
      name: "Moonli",
      url: `${SITE_ORIGIN}/`,
      inLanguage: "de",
      publisher: { "@id": `${SITE_ORIGIN}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE_ORIGIN}/#app`,
      name: "Moonli",
      alternateName: "Moonli Baby/Parent Assistant",
      applicationCategory: "HealthApplication",
      operatingSystem: "iOS, Android",
      description,
      url: `${SITE_ORIGIN}/`,
      image: `${SITE_ORIGIN}/og-image.png`,
      author: { "@id": `${SITE_ORIGIN}/#organization` },
      publisher: { "@id": `${SITE_ORIGIN}/#organization` },
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
      downloadUrl: [appStoreUrl, playStoreUrl],
    },
  ],
};
---

<BaseLayout
  title="Baby-App: Schlaf, Stillen, Wachfenster & Beikost | Moonli"
  description={description}
  canonical={canonicalUrl("/")}
  jsonLd={jsonLd}
>
  <LandingPage client:load />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingPage from "@/components/react/LandingPage";
import { SITE_ORIGIN, canonicalUrl } from "@/lib/seo";

const description =
  "Schlaf und Stillen ab der Geburt. Beikost, wenn der Löffel kommt. Wachfenster nach Alter, und beide Eltern sehen denselben Stand.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Moonli",
  alternateName: "Moonli Baby/Parent Assistant",
  applicationCategory: "HealthApplication",
  operatingSystem: "iOS, Android",
  description,
  url: `${SITE_ORIGIN}/`,
  image: `${SITE_ORIGIN}/og-image.png`,
  author: { "@type": "Person", name: "Christian Molnar" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  downloadUrl: [
    "https://apps.apple.com/us/app/moonli-baby-parent-assistant/id6762447948",
    "https://play.google.com/store/apps/details?id=com.christian.moonli&hl=de",
  ],
};
---

<BaseLayout
  title="Eltern-App für Babyschlaf, Stillen und Beikost | Moonli"
  description={description}
  canonical={canonicalUrl("/")}
  jsonLd={jsonLd}
>
  <LandingPage client:load />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingPage from "@/components/react/LandingPage";
import { SITE_ORIGIN, canonicalUrl } from "@/lib/seo";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Moonli",
  alternateName: "Moonli Baby/Parent Assistant",
  applicationCategory: "HealthApplication",
  operatingSystem: "iOS, Android",
  description:
    "Kostenloses Schlaftracking, Wachfenster nach Alter und ein gemeinsamer Überblick für beide Eltern. Stillen, Windeln und Wachstum an einem Ort.",
  url: `${SITE_ORIGIN}/`,
  image: `${SITE_ORIGIN}/og-image.png`,
  author: { "@type": "Person", name: "Christian Molnar" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  downloadUrl: [
    "https://apps.apple.com/us/app/moonli-baby-parent-assistant/id6762447948",
    "https://play.google.com/store/apps/details?id=com.christian.moonli&hl=de",
  ],
};
---

<BaseLayout
  title="Moonli: Baby-App für Schlaf, Wachfenster und Tracking"
  description="Kostenloses Schlaftracking, Wachfenster nach Alter und ein gemeinsamer Überblick für beide Eltern. Stillen, Windeln und Wachstum an einem Ort."
  canonical={canonicalUrl("/")}
  jsonLd={jsonLd}
>
  <LandingPage client:load />
</BaseLayout>

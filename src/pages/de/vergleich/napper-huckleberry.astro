---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GuideChrome from "@/components/react/GuideChrome";
import { SITE_ORIGIN, canonicalUrl } from "@/lib/seo";

const canonical = canonicalUrl("/de/vergleich/napper-huckleberry/");
const title = "Moonli vs Napper vs Huckleberry: Kosten & Funktionen";
const description =
  "Transparenter Vergleich: Was kostet Napper, Huckleberry und Moonli – und welche Features bleiben bei Moonli dauerhaft kostenlos? Stand November 2026.";
const checkedAt = "2026-11-02";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      dateModified: `${checkedAt}T12:00:00+01:00`,
      inLanguage: "de-AT",
      isPartOf: { "@type": "WebSite", name: "Moonli", url: SITE_ORIGIN },
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Was kostet eine Napper-Alternative?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Moonli Tracking (Schlaf, Stillen, Windeln, Wachstum) bleibt dauerhaft kostenlos. Premium kostet 5 € pro Monat im Jahresabo oder 7 € monatlich kündbar, mit einem Monat Test.",
          },
        },
        {
          "@type": "Question",
          name: "Ist Moonli eine Alternative zu Napper und Huckleberry?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Ja, für Familien, die Schlaf, Stillen und Beikost tracken und den Stand zu zweit brauchen. Napper und Huckleberry sind stärker auf Schlafpläne und Vorhersagen ausgerichtet; Moonli legt den Fokus auf kostenloses Tracking, Parent-Sync und Beikost/BLW.",
          },
        },
        {
          "@type": "Question",
          name: "Was kostet Napper Unlimited?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Laut Napper-Preisseite liegt Unlimited bei etwa 69,99 USD pro Jahr. Die Basisfunktionen haben eine Free-Stufe. Preise können sich ändern – bitte auf napper.app prüfen.",
          },
        },
        {
          "@type": "Question",
          name: "Was kostet Huckleberry Plus?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Laut Huckleberry-Preisseite liegt Plus bei etwa 11,99 USD pro Monat. Es gibt Free, Plus und Premium. Preise können sich ändern – bitte auf huckleberrycare.com prüfen.",
          },
        },
        {
          "@type": "Question",
          name: "Wo werden Moonli-Daten gespeichert?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Moonli hostet die App-Daten in der EU.",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout {title} {description} {canonical} jsonLd={jsonLd}>
  <GuideChrome client:load language="de" languageHrefs={{ de: "/de/vergleich/napper-huckleberry/" }} />
  <main class="container max-w-3xl py-28 md:py-32 px-4">
    <nav class="mb-6 text-sm text-muted-foreground" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-foreground transition-colors">Start</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/de/ratgeber/" class="hover:text-foreground transition-colors">Ratgeber</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-foreground">Vergleich</li>
      </ol>
    </nav>

    <p class="mb-3 text-sm font-semibold text-primary">Vergleich</p>
    <h1 class="text-display-md text-foreground text-balance">
      Moonli vs Napper vs Huckleberry
    </h1>
    <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
      Du suchst eine <strong class="text-foreground font-semibold">Napper-Alternative</strong> oder
      vergleichst Huckleberry? Hier stehen Kosten und Funktionen nebeneinander – ohne Marketing-Nebel.
      Stand der Konkurrenzpreise: {checkedAt} (Quellen verlinkt; Beträge können sich ändern).
    </p>

    <section class="mt-12" aria-labelledby="kosten">
      <h2 id="kosten" class="text-2xl font-bold text-foreground">Kosten im Überblick</h2>
      <p class="mt-3 text-muted-foreground leading-relaxed">
        Der größte Unterschied: Bei Moonli bleibt das Kern-Tracking dauerhaft gratis. Bei Napper und
        Huckleberry sitzen Schlafplan, Vorhersagen und viele Statistiken hinter dem Abo.
      </p>

      <div class="mt-6 overflow-x-auto rounded-[1.75rem] border border-border bg-card shadow-sm">
        <table class="w-full min-w-[40rem] border-separate border-spacing-0 text-left text-sm">
          <thead>
            <tr>
              <th scope="col" class="sticky left-0 z-10 bg-card px-4 py-4 font-semibold text-foreground sm:px-5">Preis</th>
              <th scope="col" class="px-4 py-4 font-semibold text-muted-foreground sm:px-5">Napper</th>
              <th scope="col" class="px-4 py-4 font-semibold text-muted-foreground sm:px-5">Huckleberry</th>
              <th scope="col" class="border-x border-t border-primary/35 bg-primary/[0.08] px-4 py-4 sm:px-5">
                <span class="flex flex-col gap-1.5">
                  <span class="w-fit rounded-full bg-primary px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-primary-foreground">
                    Empfohlen
                  </span>
                  <span class="text-base font-bold text-foreground">Moonli</span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-4 font-medium text-foreground sm:px-5">Free</th>
              <td class="border-t border-border px-4 py-4 text-muted-foreground sm:px-5">Free-Stufe mit Basis-Tracking und altersbasiertem Schlafplan</td>
              <td class="border-t border-border px-4 py-4 text-muted-foreground sm:px-5">Free: Basis-Logging und einfache Reports</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-4 text-foreground sm:px-5">
                <strong>0 €</strong> für immer – Schlaf, Stillen/Flasche, Windeln, Wachstum, Info-Hub, White Noise, Auswahl Geschichten
              </td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-4 font-medium text-foreground sm:px-5">Bezahlt</th>
              <td class="border-t border-border px-4 py-4 text-muted-foreground sm:px-5">
                Unlimited ca. <strong class="text-foreground">69,99 USD / Jahr</strong>
                <span class="mt-1 block text-xs">
                  Quelle: <a class="underline hover:text-foreground" href="https://napper.app/en/pricing/" target="_blank" rel="noopener noreferrer">napper.app/pricing</a>
                </span>
              </td>
              <td class="border-t border-border px-4 py-4 text-muted-foreground sm:px-5">
                Plus ca. <strong class="text-foreground">11,99 USD / Monat</strong> · Premium darüber
                <span class="mt-1 block text-xs">
                  Quelle: <a class="underline hover:text-foreground" href="https://huckleberrycare.com/pricing" target="_blank" rel="noopener noreferrer">huckleberrycare.com/pricing</a>
                </span>
              </td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-4 text-foreground sm:px-5">
                <strong>5 € / Monat</strong> im Jahresabo
                <span class="mt-1 block text-xs text-muted-foreground">oder 7 € / Monat monatlich kündbar · 1 Monat testen</span>
              </td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-4 font-medium text-foreground sm:px-5">Grobrechnung / Jahr</th>
              <td class="border-t border-border px-4 py-4 text-muted-foreground sm:px-5">~70 USD Unlimited</td>
              <td class="border-t border-border px-4 py-4 text-muted-foreground sm:px-5">~144 USD Plus (12×11,99)</td>
              <td class="border-x border-b border-primary/35 bg-primary/[0.08] px-4 py-4 text-foreground sm:px-5">
                <strong>~60 €</strong> Premium Jahresabo – oder <strong>0 €</strong>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-muted-foreground">
        USD-Preise der Konkurrenz ohne Umrechnung und ohne Store-Steuern. Moonli-Preise wie auf
        <a href="/#preise" class="underline hover:text-foreground">moonli.net/#preise</a>.
      </p>
    </section>

    <section class="mt-14" aria-labelledby="features">
      <h2 id="features" class="text-2xl font-bold text-foreground">Funktionen: worauf es ankommt</h2>
      <p class="mt-3 text-muted-foreground leading-relaxed">
        Napper und Huckleberry sind stark bei Schlafplänen und Vorhersagen. Moonli ist stark, wenn ihr
        den Tag zu zweit trackt, Stillen und später Beikost braucht – und nicht für jedes Statistik-Feature
        zahlen wollt.
      </p>

      <div class="mt-6 overflow-x-auto rounded-[1.75rem] border border-border bg-card shadow-sm">
        <table class="w-full min-w-[44rem] border-separate border-spacing-0 text-left text-sm">
          <thead>
            <tr>
              <th scope="col" class="sticky left-0 z-10 bg-card px-4 py-4 font-semibold text-foreground sm:px-5">Thema</th>
              <th scope="col" class="px-4 py-4 font-semibold text-muted-foreground sm:px-5">Napper</th>
              <th scope="col" class="px-4 py-4 font-semibold text-muted-foreground sm:px-5">Huckleberry</th>
              <th scope="col" class="border-x border-t border-primary/35 bg-primary/[0.08] px-4 py-4 sm:px-5">
                <span class="flex flex-col gap-1.5">
                  <span class="w-fit rounded-full bg-primary px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-primary-foreground">
                    Empfohlen
                  </span>
                  <span class="text-base font-bold text-foreground">Moonli</span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">Schlaf tracken</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Ja · Fokus der App</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Ja · Fokus der App</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-3.5 font-medium text-foreground sm:px-5">Ja · kostenlos</td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">Schlafplan / Vorhersage</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Stärke: altersbasierter Plan &amp; Personalisierung</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Stärke: SweetSpot® &amp; Schedule Creator (Plus/Premium)</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-3.5 text-foreground sm:px-5">Wachfenster-Orientierung &amp; Tagesplan (Premium)</td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">Stillen &amp; Flasche</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Tracking möglich</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Tracking möglich</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-3.5 font-medium text-foreground sm:px-5">Stillprotokoll · kostenlos</td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">Beikost / BLW</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Eher Nebenrolle</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Logging möglich, kein BLW-Fokus</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-3.5 font-medium text-foreground sm:px-5">Teller, 100+ Zutaten, eigene Rezepte</td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">Beide Eltern / Sync</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Teilen möglich (je nach Plan)</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Mehrere Geräte auf demselben Account</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-3.5 font-medium text-foreground sm:px-5">Parent-Sync in Echtzeit (Premium)</td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">Care-Arbeit spielerisch</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">—</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">—</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-3.5 font-medium text-foreground sm:px-5">Punkte, Ehren-Rad, Komplimente (Premium)</td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">White Noise &amp; Geschichten</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Schlafgeräusche (Unlimited)</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Kein vergleichbarer Fokus</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-3.5 font-medium text-foreground sm:px-5">Ja · große Auswahl schon in Free</td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">Werbefrei</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Abo-Modell</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Abo-Modell</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-3.5 font-medium text-foreground sm:px-5">Premium 100 % werbefrei</td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">Datenspeicherung</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Je nach Anbieter / Region</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Je nach Anbieter / Region</td>
              <td class="border-x border-primary/35 bg-primary/[0.08] px-4 py-3.5 font-medium text-foreground sm:px-5">Daten in der EU gehostet</td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="sticky left-0 z-10 border-t border-border bg-card px-4 py-3.5 font-medium text-foreground sm:px-5">Made for DACH</th>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Intl. · starke DE-Inhalte</td>
              <td class="border-t border-border px-4 py-3.5 text-muted-foreground sm:px-5">Vor allem EN / US</td>
              <td class="border-x border-b border-primary/35 bg-primary/[0.08] px-4 py-3.5 font-medium text-foreground sm:px-5">Ja · Wien, DE/AT-Ratgeber</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14" aria-labelledby="fuer-wen">
      <h2 id="fuer-wen" class="text-2xl font-bold text-foreground">Für wen welche App?</h2>
      <ul class="mt-4 space-y-4 text-muted-foreground leading-relaxed">
        <li>
          <strong class="text-foreground">Napper</strong>, wenn ihr vor allem einen festen Schlafplan und
          Vorhersagen wollt und dafür ein Jahresabo akzeptiert.
        </li>
        <li>
          <strong class="text-foreground">Huckleberry</strong>, wenn ihr SweetSpot®, Insights und ggf.
          Expert-Pläne sucht und den monatlichen US-Preis mitgeht.
        </li>
        <li>
          <strong class="text-foreground">Moonli</strong>, wenn Tracking dauerhaft kostenlos bleiben soll,
          beide Eltern denselben Stand brauchen, Stillen sowie später Beikost/BLW genauso zählen wie Schlaf –
          und die Daten in der EU liegen sollen.
        </li>
      </ul>
    </section>

    <section class="mt-14" aria-labelledby="weiter">
      <h2 id="weiter" class="text-2xl font-bold text-foreground">Weiterlesen &amp; ausprobieren</h2>
      <ul class="mt-4 space-y-2 text-muted-foreground">
        <li>
          <a class="font-semibold text-foreground underline-offset-4 hover:underline" href="/de/ratgeber/babyschlaf-routinen/">Babyschlaf: Abendroutine</a>
        </li>
        <li>
          <a class="font-semibold text-foreground underline-offset-4 hover:underline" href="/de/ratgeber/stillen-flaschchen-tracken/">Stillprotokoll &amp; Still-App</a>
        </li>
        <li>
          <a class="font-semibold text-foreground underline-offset-4 hover:underline" href="/de/ratgeber/beikost-starten/">Beikost starten</a>
        </li>
        <li>
          <a class="font-semibold text-foreground underline-offset-4 hover:underline" href="/de/ratgeber/wachfenster-baby/">Wachfenster nach Alter</a>
        </li>
        <li>
          <a class="font-semibold text-foreground underline-offset-4 hover:underline" href="/#preise">Moonli Preise</a>
          {" · "}
          <a class="font-semibold text-foreground underline-offset-4 hover:underline" href="/#download">Kostenlos laden</a>
        </li>
      </ul>
    </section>

    <section class="mt-14 rounded-3xl border border-border bg-card p-6 sm:p-8" aria-labelledby="faq">
      <h2 id="faq" class="text-2xl font-bold text-foreground">Häufige Fragen</h2>
      <dl class="mt-6 space-y-6">
        <div>
          <dt class="font-semibold text-foreground">Ist Moonli eine Napper-Alternative?</dt>
          <dd class="mt-2 text-muted-foreground leading-relaxed">
            Ja – besonders wenn euch Kosten und gemeinsames Tracking wichtiger sind als ein starrer Schlafplan.
            Napper bleibt stark bei Vorhersage und Schlafkurs; Moonli bei Free-Tracking, Stillprotokoll und Beikost.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-foreground">Kann ich Huckleberry ersetzen?</dt>
          <dd class="mt-2 text-muted-foreground leading-relaxed">
            Für Logging von Schlaf und Mahlzeiten ja. Wenn ihr auf SweetSpot® und Expert-Pläne angewiesen seid,
            bleibt Huckleberry Plus/Premium die speziellere Lösung – zu einem höheren Monatspreis.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-foreground">Wo werden die Daten gespeichert?</dt>
          <dd class="mt-2 text-muted-foreground leading-relaxed">
            Bei Moonli werden die App-Daten in der EU gehostet. Bei Napper und Huckleberry hängt die
            Speicherung vom jeweiligen Anbieter und der Region ab – bitte in deren Datenschutzhinweisen prüfen.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-foreground">Ändern sich die Preise?</dt>
          <dd class="mt-2 text-muted-foreground leading-relaxed">
            Konkurrenzpreise haben wir am {checkedAt} von den verlinkten Seiten übernommen. Vor dem Kauf immer
            die aktuellen Store- und Website-Preise prüfen. Moonli-Preise stehen live unter /#preise.
          </dd>
        </div>
      </dl>
    </section>

    <p class="mt-10 text-xs text-muted-foreground leading-relaxed">
      Keine bezahlte Kooperation. Vergleich auf Basis öffentlich einsehbarer Preisseiten und unserer eigenen
      Produktfunktionen. Napper® und Huckleberry® sind Marken der jeweiligen Anbieter.
    </p>
  </main>
</BaseLayout>

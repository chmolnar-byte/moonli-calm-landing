---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { canonicalUrl } from "@/lib/seo";

/** Retired blog posts: 200 + noindex so Google can drop them (redirects alone fail live indexing tests). */
export function getStaticPaths() {
  return [
    { params: { slug: "partner/freizeit-baby-kleinkind-wien-ankerzeit" } },
    { params: { slug: "archiv" } },
  ];
}

const { slug } = Astro.params;
---

<BaseLayout
  title="Beitrag nicht mehr verfügbar | Moonli"
  description="Dieser frühere Blogbeitrag ist nicht mehr verfügbar."
  canonical={canonicalUrl("/")}
  noindex={true}
>
  <main class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-start justify-center gap-4 px-6 py-16">
    <h1 class="text-2xl font-semibold tracking-tight text-foreground">Beitrag nicht mehr verfügbar</h1>
    <p class="text-sm leading-relaxed text-muted-foreground">
      „{slug}“ gehört zum früheren Moonli-Blog und wurde entfernt.
    </p>
    <a
      href="/"
      class="inline-flex items-center rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground"
    >
      Zur Startseite
    </a>
  </main>
</BaseLayout>

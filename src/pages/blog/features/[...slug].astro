---
import { getCollection } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogChrome from "@/components/react/BlogChrome";
import { getPostCoverImage } from "@/lib/blogImages";

export async function getStaticPaths() {
  const posts = await getCollection("features", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const coverImage = getPostCoverImage(post);
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  image={coverImage}
  imageAlt={post.data.imageAlt ?? post.data.title}
  category="features"
  categoryLabel="Moonli Features"
  tags={post.data.tags}
>
  <BlogChrome client:load slot="nav" mode="nav" />
  <Content />
  <BlogChrome client:load slot="footer" mode="footer" />
</BlogLayout>

---
import { getCollection } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogChrome from "@/components/react/BlogChrome";

export async function getStaticPaths() {
  const posts = await getCollection("news", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  category="news"
  categoryLabel="News"
  tags={post.data.tags}
>
  <BlogChrome client:load slot="nav" mode="nav" />
  <Content />
  {post.data.sources && post.data.sources.length > 0 && (
    <section class="mt-10 not-prose">
      <h2 class="text-lg font-bold mb-3">Quellen</h2>
      <ul class="space-y-1 text-sm text-muted-foreground">
        {post.data.sources.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
              {source.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  <BlogChrome client:load slot="footer" mode="footer" />
</BlogLayout>

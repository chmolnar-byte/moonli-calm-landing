---
import "@/index.css";
import { SITE_ORIGIN, canonicalUrl as toCanonical } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  lang?: string;
  ogLocale?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  author?: string;
}

const {
  title = "Moonli. Die Baby-/Elternapp für deinen Alltag.",
  description = "Moonli 2.0: Neues Design, Parent-Sync in Echtzeit, eigene Quick-Buttons, Info-Hub, mehr Geschichten und Spiele – und Care-Arbeit gemeinsam teilen.",
  canonical,
  ogImage = `${SITE_ORIGIN}/og-image.png`,
  ogType = "website",
  noindex = false,
  lang = "de",
  ogLocale = "de_AT",
  jsonLd,
  author = "Christian Molnar",
} = Astro.props;

const canonicalUrl = toCanonical(canonical ?? Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <!--
      Consent Mode v2: everything denied by default. The Google tag itself (gtag.js) is NOT loaded here.
      It is only injected by src/lib/analytics.ts after the visitor has agreed to analytics cookies.
    -->
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });
    `} />

    <script is:inline>
      (function () {
        try {
          var h = new Date().getHours();
          var phase = h >= 19 || h < 7 ? "dark" : "light";
          var theme = phase;
          var parts = (localStorage.getItem("moonli_theme_choice_v2") || "").split(":");
          if ((parts[0] === "dark" || parts[0] === "light") && parts[1] === phase) theme = parts[0];
          if (theme === "dark") document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="theme-color" content="#EFE4D4" />
    <meta name="application-name" content="Moonli" />
    <meta name="apple-itunes-app" content="app-id=6762447948" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={`${SITE_ORIGIN}/sitemap-index.xml`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <meta property="og:site_name" content="Moonli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <slot name="head" />
  </head>
  <body>
    <slot /><script is:inline>
(function () {
  var STORAGE_KEY = "moonli_campaign_params_v1";
  var PARAM_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "utm_id", "fbclid", "gclid"];
  var params = new URLSearchParams(location.search);
  var fromUrl = {};
  for (var i = 0; i < PARAM_KEYS.length; i++) {
    var key = PARAM_KEYS[i];
    var value = params.get(key);
    if (value) fromUrl[key] = value;
  }
  if (fromUrl.fbclid && !fromUrl.utm_source) {
    fromUrl.utm_source = "meta";
    fromUrl.utm_medium = fromUrl.utm_medium || "paid";
  }
  var stored = {};
  try { stored = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || "{}") || {}; } catch (e) {}
  var campaign = Object.assign({}, stored, fromUrl);
  if (Object.keys(fromUrl).length) {
    try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(campaign)); } catch (e) {}
  }

  var visitorKey = "moonli_web_visitor";
  var id = localStorage.getItem(visitorKey);
  if (!id) {
    id = Math.random().toString(36).slice(2) + Date.now().toString(36);
    localStorage.setItem(visitorKey, id);
  }
  fetch("https://app.moonli.net/api/insights/beacon", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      secret: "E6Sd4HB^7pC5GFK4GNzkp^@Wt",
      path: location.pathname || "/",
      source: campaign.utm_source || "",
      medium: campaign.utm_medium || "",
      campaign: campaign.utm_campaign || "",
      content: campaign.utm_content || "",
      fbclid: campaign.fbclid ? "1" : "",
      referrer: document.referrer || "",
      visitorId: id
    })
  }).catch(function () {});
})();
</script>
  </body>
</html>
